# Copy this file to .env.local and fill in real values.
# In production (Vercel), set these in Project Settings -> Environment Variables.

# MongoDB connection string (required)
# MongoDB Atlas: allow 0.0.0.0/0 under Network Access so Vercel can connect.
MONGODB_URI=

# Admin mailbox that RECEIVES contact-form leads (Gmail address + app password)
EMAIL_USER=
EMAIL_PASS=

# Sender mailbox used to SEND the notification/thank-you emails (Gmail address + app password)
CLIENT_USER=
CLIENT_PASS=
